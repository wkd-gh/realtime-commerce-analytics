# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094
KAFKA_ZOOKEEPER=localhost:2181

# YouTube API
YOUTUBE_API_KEY=your_youtube_api_key

# Twitter API
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Naver Shopping API
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=commerce_analytics
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_password

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=commerce_analytics
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=your_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# Slack
SLACK_WEBHOOK_URL=your_slack_webhook_url

# Superset
SUPERSET_SECRET_KEY=your_secret_key_here
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Spark
SPARK_MASTER_URL=spark://localhost:7077
SPARK_APP_NAME=commerce-analytics-streaming

# Producer Settings
PRODUCER_BATCH_SIZE=100
PRODUCER_LINGER_MS=10

# ML Settings
SENTIMENT_MODEL=klue/bert-base
SENTIMENT_BATCH_SIZE=32

# Alert Thresholds
TRENDING_ZSCORE_THRESHOLD=3.0
NEGATIVE_SENTIMENT_THRESHOLD=0.7
